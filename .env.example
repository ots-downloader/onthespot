# Optional. Every value below is already the default in compose.yml.
# To change one, copy this file to .env next to compose.yml and edit it.
# Relative paths are resolved from the directory containing compose.yml.
ONTHESPOT_WEB_PORT=6767
ONTHESPOT_MUSIC_DIR=./otsdata/Music
ONTHESPOT_VIDEO_DIR=./otsdata/Videos
ONTHESPOT_CONFIG_DIR=./otsdata/Config

# User and group IDs the app runs as. They must be able to write to the
# data folders; a folder they cannot write to gets this owner on start.
# PUID=1000
# PGID=1000

# Image to run, for example ghcr.io/ots-downloader/onthespot:edge.
# ONTHESPOT_IMAGE=moddroid94/ots-dl:latest

# URL of the bgutil PO token server for YouTube Music.
# Blank means the bgutil-provider service in compose.yml.
# ONTHESPOT_BGUTIL_URL=http://bgutil-provider:4416
